# Kopier til .env og fyll inn:  cp .env.example .env && nano .env
# .env skal ALDRI inn i git (den står i .gitignore).

# --- Domenet ---------------------------------------------------------------
# Navnet du lager på duckdns.org, uten https:// foran.
# Alle tre linjene skal ha samme navn.
# VIKTIG: bestem navnet før dere lager profiler. Passkeys er låst til dette navnet.
DOMAIN=mitt-gym.duckdns.org
RP_ID=mitt-gym.duckdns.org
ORIGIN=https://mitt-gym.duckdns.org

# Navnet som vises når iPhone spør om passkey.
RP_NAME=Treningsapp

# --- Hvem får komme inn ----------------------------------------------------
# Den første profilen som lages blir admin. Lag din egen først!
FIRST_USER_ADMIN=1
# Ingen «fortsett uten konto».
ALLOW_GUEST=0
# Slå på (fjern #) etter at dere begge har laget profil, og kjør: docker compose up -d
# INVITE_ONLY=1

# --- Integrasjoner ---------------------------------------------------------
# Webhooks, som Garmin-synken skal bruke senere.
INTEGRATIONS=webhook

TZ=Europe/Oslo
